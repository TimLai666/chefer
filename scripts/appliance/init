#!/bin/busybox sh
set -eu

PATH=/bin:/sbin:/usr/bin:/usr/sbin
/bin/busybox --install -s /bin >/dev/null 2>&1 || true

mountpoint() {
  grep -qs " $1 " /proc/mounts
}

report() {
  msg="$1"
  if [ -w /dev/kmsg ]; then
    # `quiet` 會壓低 console_loglevel；用高優先序 kmsg 確保關鍵標記仍會出現在 console。
    printf '<0>%s\n' "$msg" >/dev/kmsg 2>/dev/null || printf '%s\n' "$msg"
  else
    printf '%s\n' "$msg"
  fi
}

log() {
  report "[chefer-init] $*"
}

emit_exit() {
  report "CHEFER_GUEST_EXIT=$1"
}

fail() {
  code="${2:-1}"
  log "錯誤：$1"
  emit_exit "$code"
  sync
  poweroff -f >/dev/null 2>&1 || halt -f >/dev/null 2>&1 || true
  while true; do sleep 3600; done
}

mkdir -p /proc /sys /dev /dev/pts /dev/shm /run /tmp /mnt
mountpoint /proc || mount -t proc proc /proc || true

# initramfs 的根（rootfs）上 pivot_root 一律 EINVAL——pasta（bridge 出網）自我沙箱需要
# pivot_root 進空 tmpfs，會直接失敗退出。故先 switch_root 到 tmpfs 根（真 mount），
# 再重跑本 init（第二次進來根已是 tmpfs，此區塊自動跳過）。
if grep -qs "^rootfs / rootfs" /proc/mounts; then
  mkdir -p /newroot
  if mount -t tmpfs -o mode=0755 tmpfs /newroot; then
    mkdir -p /newroot/bin /newroot/dev /newroot/proc /newroot/sys \
      /newroot/run /newroot/tmp /newroot/mnt
    cp /bin/busybox /newroot/bin/busybox
    cp /init /newroot/init
    chmod 0755 /newroot/init /newroot/bin/busybox
    # switch_root 需要新根有 console node；devtmpfs 由第二階段重掛。
    mknod -m 0600 /newroot/dev/console c 5 1 2>/dev/null || true
    mknod -m 0666 /newroot/dev/null c 1 3 2>/dev/null || true
    exec switch_root /newroot /init
  fi
fi
mountpoint /sys || mount -t sysfs sysfs /sys || true
mountpoint /dev || mount -t devtmpfs devtmpfs /dev || mount -t tmpfs devtmpfs /dev || true
mkdir -p /dev/pts /dev/shm /run /tmp /mnt
mountpoint /dev/pts || mount -t devpts devpts /dev/pts || true
mountpoint /dev/shm || mount -t tmpfs tmpfs /dev/shm || true

if [ -e /dev/hvc0 ]; then
  exec </dev/hvc0 >/dev/hvc0 2>&1
elif [ -e /dev/console ]; then
  exec </dev/console >/dev/console 2>&1
fi

cmdline="$(cat /proc/cmdline 2>/dev/null || true)"
cmd_arg() {
  key="$1"
  for token in $cmdline; do
    case "$token" in
      "$key="*) echo "${token#*=}"; return 0 ;;
      "$key") echo "1"; return 0 ;;
    esac
  done
  return 1
}

bundle_tag="$(cmd_arg chefer.bundle_tag || true)"
data_tag="$(cmd_arg chefer.data_tag || true)"
bundle_dir="$(cmd_arg chefer.bundle_dir || true)"
data_dir="$(cmd_arg chefer.data_dir || true)"
keep_rootfs="$(cmd_arg chefer.keep_rootfs || true)"

[ -n "$bundle_dir" ] || fail "kernel cmdline 缺 chefer.bundle_dir" 125
[ -n "$data_dir" ] || fail "kernel cmdline 缺 chefer.data_dir" 125

mkdir -p "$bundle_dir" "$data_dir"
if [ -e /dev/hvc0 ]; then
  [ -n "$bundle_tag" ] || fail "kernel cmdline 缺 chefer.bundle_tag" 125
  [ -n "$data_tag" ] || fail "kernel cmdline 缺 chefer.data_tag" 125
  log "掛載 bundle virtiofs tag=${bundle_tag} -> ${bundle_dir}"
  mount -t virtiofs -o ro "$bundle_tag" "$bundle_dir" \
    || fail "無法掛載唯讀 bundle virtiofs（tag=${bundle_tag}）；請確認 QEMU/VZ 已提供共享目錄" 126
  log "掛載 data virtiofs tag=${data_tag} -> ${data_dir}"
  mount -t virtiofs "$data_tag" "$data_dir" \
    || fail "無法掛載可寫 data virtiofs（tag=${data_tag}）；請確認 QEMU/VZ 已提供共享目錄" 126
else
  [ -b /dev/vda ] || fail "WHP 路徑缺少 /dev/vda；請確認 helper 已提供 bundle virtio-blk" 126
  log "WHP 路徑：從 /dev/vda 解開 bundle tar -> ${bundle_dir}"
  dd if=/dev/vda bs=64k 2>/dev/null | tar -C "$bundle_dir" -xf - \
    || fail "無法從 /dev/vda 展開 bundle image；請確認 helper 的 bundle virtio-blk 內容有效" 126
  if [ -b /dev/vdb ]; then
    log "WHP 路徑：從 /dev/vdb 解開 data tar -> ${data_dir}"
    dd if=/dev/vdb bs=64k 2>/dev/null | tar -C "$data_dir" -xf - \
      || fail "無法從 /dev/vdb 展開 data image；請確認 helper 的 data virtio-blk 內容有效" 126
    log "WHP 路徑：data 將於關機 re-tar 回寫 /dev/vdb（持久化）"
  else
    log "WHP 路徑：未提供 /dev/vdb，先使用 ephemeral data dir ${data_dir}"
  fi
fi

# bridge 出網（pasta）需要以非特權 uid 開 /dev/net/tun 在 app netns 建 tap：
# devtmpfs 對 misc 裝置預設 0600（一般發行版由 udev 放寬），這裡比照放寬為 0666。
# 節點缺失時補建（TUN 為 built-in，major 10 / minor 200）。
if [ ! -e /dev/net/tun ]; then
  mkdir -p /dev/net
  mknod /dev/net/tun c 10 200 2>/dev/null || true
fi
chmod 0666 /dev/net/tun 2>/dev/null || true

machine="$(uname -m)"
case "$machine" in
  x86_64) arch="x86_64" ;;
  aarch64|arm64) arch="aarch64" ;;
  *) fail "不支援的 guest 架構：${machine}" 125 ;;
esac

agent_src="${bundle_dir}/agents/guest-agent-${arch}"
[ -f "$agent_src" ] || fail "bundle 缺 ${agent_src}；請以含 guest-agent-${arch} 的 kit 重新打包" 127

mkdir -p /run/chefer
cp "$agent_src" /run/chefer/guest-agent \
  || fail "複製 guest-agent 到可執行暫存目錄失敗" 127
chmod 0755 /run/chefer/guest-agent || true

# rootfs 快取不能放在 virtiofs（data 共享）上：非 root virtiofsd 無法
# setfsuid，guest-agent unshare(USER) 後的 uid 映射會導致 EPERM。
# 改用 VM 本地的 tmpfs（/tmp/chefer-rootfs-cache）組裝 rootfs；
# persist 資料仍透過 virtiofs data 共享寫回 host。
cache_dir="/tmp/chefer-rootfs-cache"
mkdir -p "$cache_dir"

# 印出 guest eth0 的對外 IPv4 供 VM host（macOS vz）做 host→guest 埠轉發：VZ 的 NAT
# 不會自動把 host 埠轉進 guest，host 端需直接連 guest IP relay。取不到不致命（純 stdout 應用
# 或無宣告埠時無妨）。QEMU 走 slirp hostfwd 不需這個，但印出來也無害、且可被 e2e 驗證。
guest_ip="$(/run/chefer/guest-agent vmip 2>/dev/null || true)"
if [ -n "$guest_ip" ]; then
  report "CHEFER_GUEST_IP=${guest_ip}"
fi

# --udp-bridge：VM 內補起 UDP 埠的 eth0→loopback 橋接（無 UDP 埠時為 no-op）。
# host 端（macOS vz）的 UDP relay 待實機實作；guest 側先就緒。
set +e
if [ "$keep_rootfs" = "1" ]; then
  /run/chefer/guest-agent run --bundle "$bundle_dir" --data "$data_dir" --cache "$cache_dir" --udp-bridge --keep-rootfs
else
  /run/chefer/guest-agent run --bundle "$bundle_dir" --data "$data_dir" --cache "$cache_dir" --udp-bridge
fi
code="$?"
set -e

log "guest-agent 結束，exit=${code}"

# WHP 路徑：把 data_dir re-tar 回寫 /dev/vdb，讓 helper 關機後解回 host（persist 跨重啟）。
# 須在 poweroff 前完成（virtio-blk 寫入同步進 helper backing）。vz/QEMU 走 virtiofs 直寫
# host、無 /dev/vdb，故此區塊自動略過。conv=notrunc：不截斷固定大小的 block device。
if [ -b /dev/vdb ]; then
  log "WHP 路徑：關機回寫 data ${data_dir} -> /dev/vdb"
  tar -C "$data_dir" -cf - . 2>/dev/null | dd of=/dev/vdb bs=64k conv=notrunc 2>/dev/null \
    || log "警告：data 回寫 /dev/vdb 失敗，persist 資料可能未保存"
  sync
fi

emit_exit "$code"
sync
poweroff -f >/dev/null 2>&1 || halt -f >/dev/null 2>&1 || true
while true; do sleep 3600; done
